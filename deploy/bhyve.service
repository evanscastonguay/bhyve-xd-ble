# Template for the system unit that runs the server on the always-on Linux box.
# Paths/user assume the ~/bhyve/{releases,shared,current} layout and user `pi` — adjust to match.
# Install (one-time): sudo cp deploy/bhyve.service /etc/systemd/system/bhyve.service
#                     sudo systemctl daemon-reload && sudo systemctl enable --now bhyve.service
[Unit]
Description=B-Hyve XD BLE local server
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/bhyve/current
ExecStart=/home/pi/bhyve/current/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
