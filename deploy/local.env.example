# Copy to deploy/local.env (gitignored) and set your real deploy targets.
# deploy.sh / rollback.sh source local.env if present, so you don't pass env vars each time.
export BHYVE_REMOTE="bhyve-linux"                     # ssh alias / host of the always-on box
export BHYVE_BASE="/home/pi/bhyve"                    # release-layout root on the box
export BHYVE_HEALTH_URL="http://192.168.1.50:8000"    # where the box serves the API
